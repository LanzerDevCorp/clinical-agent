{
  "name": "clinical-agent",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts tests/unit",
    "db:seed": "tsx --env-file=.env src/scripts/seed-catalogs.ts",
    "db:ingest": "tsx --env-file=.env src/scripts/ingest-extracted-products.ts",
    "db:local:seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-local.ts",
    "db:local:seed:fiction": "cross-env SEED_DATASET=fiction NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-local.ts",
    "db:local:fixture": "node src/scripts/extract-real-catalogue.mjs",
    "db:local:mcp-key": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/create-mcp-readonly-key.ts",
    "db:vocabulary": "node src/scripts/dump-vocabulary.mjs",
    "db:local:reset": "supabase db reset && pnpm payload migrate && pnpm run db:local:seed",
    "db:reset-safety": "tsx --env-file=.env src/scripts/reset-clinical-safety.ts",
    "check:gateway-model": "tsx src/scripts/check-gateway-model.ts",
    "db:vocabulary:audit": "tsx --env-file=.env src/scripts/audit-vocabulary.ts",
    "db:promotion:extract": "cross-env FIXTURE_SOURCE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres FIXTURE_OUT_PATH=tmp/migration/promotion/local-catalogue.json node src/scripts/extract-real-catalogue.mjs",
    "db:promotion:dry-run": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/promote-catalogue-to-production.ts",
    "db:promotion:apply": "cross-env PROMOTE_CONFIRM=yes NODE_OPTIONS=--no-deprecation payload run src/scripts/promote-catalogue-to-production.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.246",
    "@payloadcms/db-postgres": "3.85.1",
    "@payloadcms/next": "3.85.1",
    "@payloadcms/plugin-mcp": "^3.85.1",
    "@payloadcms/richtext-lexical": "3.85.1",
    "@payloadcms/ui": "3.85.1",
    "@react-pdf/renderer": "^4.5.1",
    "ai": "6.0.244",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^1.39.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "payload": "3.85.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "^4.19.1",
    "sharp": "0.34.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "jsdom": "28.0.0",
    "postcss": "^8.5.26",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  }
}
