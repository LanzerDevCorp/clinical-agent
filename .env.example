# Copy to .env and fill in. .env is gitignored and never leaves your machine.
#
# Values with symbols must be percent-encoded in a connection string:
#   @ -> %40    $ -> %24    # -> %23    / -> %2F
# The `$` matters beyond URL parsing: Payload reads the environment through
# @next/env, whose expand step treats a literal `$` as a variable reference and
# silently truncates the value. A password that looks right then fails as
# "password authentication failed" with nothing else to go on.

# --- Required -----------------------------------------------------------------

# Local development points at the Supabase CLI instance. See supabase/README.md.
# payload.config.ts refuses to start when this is a remote host and the process
# is not a deployment, so a copy of production here stops the app rather than
# quietly writing to real clinical data.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Deliberately empty. Payload signs its session tokens with this value directly,
# so a shared or guessable one lets anyone mint an administrator session. It was
# once shipped here as `your-secret-here`, that placeholder reached a deployed
# environment, and nobody noticed until it was audited. An empty value stops
# Payload at startup, which is the correct failure.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PAYLOAD_SECRET=

# HMAC key for the clinical agent's rate limiting. User ids are never stored:
# only HMAC(secret, "users:<id>"). Without this the agent admits nobody, which is
# safe but total — it fails closed.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMISSION_HASH_SECRET=

# --- Local development --------------------------------------------------------

# Vercel AI Gateway. A deployment on Vercel authenticates through OIDC and does
# not need this; a developer machine does.
AI_GATEWAY_API_KEY=

# The admin account src/scripts/seed-local.ts recreates after every reset, so a
# wiped database does not send you back to Payload's first-user wizard. Left
# empty the seed falls back to dev@local.test / localdev, which is enough to log
# in on a fresh clone. Fill these in with your own and they survive every reset.
# Keep them here rather than in the script: the script is committed, .env is not.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Deployments only ---------------------------------------------------------
# Leave these unset locally.

# The origin the browser sees. Vercel deployments derive it from their own
# system variables, so this is only needed elsewhere, and it must match exactly:
# scheme and host, no trailing slash. A mismatch makes Payload ignore the auth
# cookie and answer every browser request with 403.
# PAYLOAD_PUBLIC_SERVER_URL=https://example.com

# Supabase signs its Postgres certificate with a private CA, and a deployment has
# no certificate file to point at. Paste the PEM, newlines and all. When set, any
# ssl parameter in DATABASE_URL is stripped so it cannot override this.
# SUPABASE_CA_CERT=

# Confirms a remote database is intended. Deployments on Vercel are detected
# automatically; set this where that detection cannot be relied on, or prefix it
# on the single command that must reach production:
#   ALLOW_REMOTE_DATABASE=1 pnpm payload migrate
# ALLOW_REMOTE_DATABASE=1
